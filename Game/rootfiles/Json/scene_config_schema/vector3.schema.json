{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vector3.schema.json",
  "title": "Vector3",
  "type": "object",
  "properties": {
    "x": {
      "type": "number",
      "default": 0.0
    },
    "y": {
      "type": "number",
      "default": 0.0
    },
    "z": {
      "type": "number",
      "default": 0.0
    }
  },
  "required": [],
  "additionalProperties": false,
  "description": "A 3D vector used for position, rotation_degrees, and scale."
}