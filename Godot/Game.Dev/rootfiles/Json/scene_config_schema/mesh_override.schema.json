{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mesh_override.schema.json",
  "title": "MeshOverride",
  "type": "object",
  "properties": {
    "path": {
      "type": "string",
      "description": "Path relative to the node to find_child()."
    },
    "visible": {
      "type": "boolean",
      "description": "Whether the target Node3D should be visible."
    }
  },
  "required": [
    "path"
  ],
  "additionalProperties": false
}