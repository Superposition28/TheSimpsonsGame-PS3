{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scene_entry.schema.json",
  "title": "SceneEntry",
  "type": "object",
  "properties": {
    "type": {
      "const": "scene"
    },
    "name": {
      "type": "string"
    },
    "path": {
      "type": "string",
      "description": "Save path for the .tscn (relative to res://)."
    },
    "class": {
      "type": "string",
      "description": "Root class to instantiate (defaults to Node)."
    },
    "script": {
      "type": "string",
      "description": "Script path to attach to the scene root."
    },
    "editable_children_default": {
      "type": "boolean",
      "default": true,
      "description": "Default for marking direct child instances editable in the editor."
    },
    "children": {
      "type": "array",
      "items": {
        "$ref": "child_entry.schema.json"
      }
    }
  },
  "required": [
    "type",
    "name",
    "path"
  ],
  "additionalProperties": false,
  "description": "Top-level scene definition."
}