[memory]

limits/message_queue/max_size_mb=64

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_s3tc_bptc=true
textures/vram_compression/import_etc2_astc=true
textures/lossless_compression/force_png=true

[shader_globals]

diffuse_curve={
"type": "sampler2D",
"value": "res://textures/diffuse-texture.tres"
}
fresnel_smoothness={
"type": "float",
"value": 0.05
}
specular_smoothness={
"type": "float",
"value": 0.05
}
outline_width={
"type": "float",
"value": 4.0
}
outline_color={
"type": "color",
"value": Color(0, 0, 0, 1)
}

[steam]

initialization/initialize_on_startup=true
initialization/embed_callbacks=false
initialization/app_id=2602390
multiplayer_peer/max_channels=4

[steam_server]

initialization/embed_callbacks=false
