# Simpsons Game STR
# script for QuickBMS http://quickbms.aluigi.org
#
# 2026-10-19: unnamed output investigation (PS3 US source / PS3 EU outputs).
# Numeric .dat names were generated by QuickBMS, not stored in the STR:
# (1) 0x2207 SimGroups have no asset path; (2) some 0x1607 assets have an
# empty path despite having metadata (observed resource type UIE).
# The old script used log "" in both cases. For zero at record+0x0c it also
# discarded four body bytes and dumped the section tail, losing boundaries.
#
# Records have a 12-byte envelope: type/padding, LE body size, version stamp.
# Only 0x1607 is parsed as asset metadata. Other bodies are preserved whole.
# SimGroup outputs now retain both leading words: SimG is at output+0x08,
# matching SimGroup.cs's body-relative pointer base (legacy DAT: SimG+0x04).
# Synthetic names use zero-based section index and decompressed record offset;
# they are stable within an archive, NOT recovered game filenames.
# Use separate output directories per archive and -o to overwrite on reruns.
# QuickBMS -K / rename-on-collision can still create extra files.
# Named assets retain their embedded paths and exact payload bytes.
# Layouts/evidence: reversing/docs/PS3_GAME/FormatAnalysis/STR/index.html
# and STR/imbedded-formats/simgroup.dat.html.

comtype dk2
endian big
idstring "SToc"
get VERSION long
get SECTION_INFO long
get STREAM_FILE long
get INFO_OFF long
xmath FILES "(SECTION_INFO >> 24) & 0xff"
xmath BASE_OFF "INFO_OFF + (FILES * 24)"
math BASE_OFF x 0x800

goto INFO_OFF
for i = 0 < FILES
    get MEMORY_POLICY long
    get COMPRESSOR long
    get DATA_SIZE long
    get ALLOC_SIZE long
    get STORED_SIZE long
    get EXTRA_SIZE long

    savepos DESCRIPTOR_POS
    goto BASE_OFF
    get SIGN short
    goto DESCRIPTOR_POS
    if SIGN == 0x10fb
        clog MEMORY_FILE BASE_OFF STORED_SIZE DATA_SIZE
    else
        log MEMORY_FILE BASE_OFF DATA_SIZE
    endif
    math BASE_OFF + STORED_SIZE

    get MEM_SIZE asize MEMORY_FILE
    for OFFSET = 0 < MEM_SIZE
        xmath ENVELOPE_END "OFFSET + 12"
        if ENVELOPE_END > MEM_SIZE
            print "ERROR: truncated STR record envelope in section %i% at %OFFSET|x%"
            cleanexit
        endif
        goto OFFSET MEMORY_FILE
        get CHUNK_TYPE short MEMORY_FILE
        get CHUNK_PADDING short MEMORY_FILE
        endian little
        get BODY_SIZE long MEMORY_FILE
        endian big
        get CHUNK_VERSION long MEMORY_FILE
        savepos BODY_OFF MEMORY_FILE
        xmath RECORD_END "BODY_OFF + BODY_SIZE"
        if RECORD_END > MEM_SIZE
            print "ERROR: STR record exceeds section %i% at %OFFSET|x%"
            cleanexit
        endif

        set HEADER_SIZE long 0
        if CHUNK_TYPE == 0x1607 && BODY_SIZE >= 4
            get HEADER_SIZE long MEMORY_FILE
        endif
        if CHUNK_TYPE == 0x1607 && HEADER_SIZE > 0
            xmath HEADER_END "BODY_OFF + 4 + HEADER_SIZE"
            if HEADER_END > RECORD_END
                print "ERROR: STR asset header exceeds record in section %i% at %OFFSET|x%"
                cleanexit
            endif
            # Length checks leave room for remaining fixed metadata fields.
            get NAMESZ long MEMORY_FILE
            savepos FIELD_OFF MEMORY_FILE
            xmath FIELD_END "FIELD_OFF + NAMESZ + 36"
            if FIELD_END > HEADER_END
                print "ERROR: invalid STR object name length"
                cleanexit
            endif
            getdstring OBJECT_NAME NAMESZ MEMORY_FILE
            getdstring ASSET_GUID 0x10 MEMORY_FILE
            get NAMESZ long MEMORY_FILE
            savepos FIELD_OFF MEMORY_FILE
            xmath FIELD_END "FIELD_OFF + NAMESZ + 16"
            if FIELD_END > HEADER_END
                print "ERROR: invalid STR resource type length"
                cleanexit
            endif
            getdstring RESOURCE_TYPE NAMESZ MEMORY_FILE
            get NAMESZ long MEMORY_FILE
            savepos FIELD_OFF MEMORY_FILE
            xmath FIELD_END "FIELD_OFF + NAMESZ + 12"
            if FIELD_END > HEADER_END
                print "ERROR: invalid STR asset path length"
                cleanexit
            endif
            getdstring NAME NAMESZ MEMORY_FILE
            get EXTRA_LEN long MEMORY_FILE
            savepos FIELD_OFF MEMORY_FILE
            xmath FIELD_END "FIELD_OFF + EXTRA_LEN + 8"
            if FIELD_END > HEADER_END
                print "ERROR: invalid STR asset extra-data length"
                cleanexit
            endif
            getdstring EXTRA_DATA EXTRA_LEN MEMORY_FILE
            get RESERVED long MEMORY_FILE
            get SIZE long MEMORY_FILE
            xmath ALIGNED_END "HEADER_END + ((SIZE + 3) & ~3)"
            if ALIGNED_END != RECORD_END
                print "ERROR: STR asset size disagrees with record in section %i% at %OFFSET|x%"
                cleanexit
            endif
            if NAME == ""
                if RESOURCE_TYPE == "UIE"
                    string NAME p "uie_s%03d_o%08x.dat" i OFFSET
                else
                    string NAME p "unnamed_asset_s%03d_o%08x.dat" i OFFSET
                endif
                print "STR unnamed asset: %NAME% type=%RESOURCE_TYPE% object=%OBJECT_NAME%"
            endif
            log NAME HEADER_END SIZE MEMORY_FILE
        else
            # Unknown bodies are not assumed to contain asset HeaderSize.
            set SIMG long 0
            if CHUNK_TYPE == 0x2207 && BODY_SIZE >= 12
                xmath SIGN_OFF "BODY_OFF + 8"
                goto SIGN_OFF MEMORY_FILE
                get SIMG long MEMORY_FILE
            endif
            if CHUNK_TYPE == 0x2207 && SIMG == 0x53696d47
                string NAME p "simgroup_s%03d_o%08x.dat" i OFFSET
            else
                string NAME p "chunk_%04x_s%03d_o%08x.dat" CHUNK_TYPE i OFFSET
                print "STR unparsed record body: %NAME%"
            endif
            log NAME BODY_OFF BODY_SIZE MEMORY_FILE
        endif
        math OFFSET = RECORD_END
    next
next i
